{
  "name": "msa-sportsbook-auth",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "FIRST_OPERATOR_TTL_SECONDS": 60,
    "FIRST_SESSION_TTL_SECONDS": 7200,
    "FIRST_TIMEOUT_MS": 7000
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "AnonymousSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AnonymousSession"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "NEW_SESSION_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
